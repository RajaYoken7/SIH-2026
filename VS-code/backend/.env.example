# ============================================================
#  DR Screening System — Backend Environment Configuration
#  Copy this file to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# MATLAB Configuration
# ----------------------------------------------------------

# Full path to matlab.exe (or just "matlab" if it's on PATH).
# Windows example: C:\Program Files\MATLAB\R2024b\bin\matlab.exe
# Linux example:   /usr/local/MATLAB/R2024b/bin/matlab
MATLAB_PATH=matlab

# Absolute path to the root of the DR-project MATLAB source.
# This is the folder that contains src/ and config/ subdirectories.
MATLAB_SRC_PATH=C:\Me\coding\SIH-2026\Mat-Lab\DR-project

# Timeout for MATLAB execution in milliseconds (default: 120000 = 2 min)
MATLAB_TIMEOUT_MS=120000

# ----------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------

PORT=3001

# Frontend origin for CORS (Vite default is 5173)
FRONTEND_ORIGIN=http://localhost:5173

# ----------------------------------------------------------
# File Storage
# ----------------------------------------------------------

# Directory for temporarily storing uploaded images.
# Created automatically on first run.
UPLOADS_DIR=uploads

# Directory for MATLAB output files (JSON + enhanced images).
# Created automatically on first run.
OUTPUTS_DIR=outputs

# How long (ms) before temp files are cleaned up.
# Default: 3600000 = 1 hour
FILE_TTL_MS=3600000
