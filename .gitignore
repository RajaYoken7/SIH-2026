# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Editor and IDE files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
.project
.settings/

# Node.js / Web
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
build/
*.local
.vite/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Backend runtime directories & uploaded/generated files
VS-code/backend/uploads/*
!VS-code/backend/uploads/.gitkeep
VS-code/backend/outputs/*
!VS-code/backend/outputs/.gitkeep

